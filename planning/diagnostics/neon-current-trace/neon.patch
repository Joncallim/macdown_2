+}
+
+/// Propagates diagnostic correlation through existing calls and tasks. No new
+/// task, suspension, cancellation or scheduling barrier is introduced.
+public enum RestoreTraceContext {
+    @TaskLocal public static var queryID = 0
+}
+
+/// Immutable metadata only. Existing queue operations keep their original scheduling.
+public struct PassiveRestoreOperation: Sendable {
+    private let key: String
+    private let fields: [String: String]
+    public init(key: String, kind: String, fields: @autoclosure () -> [String: String] = [:]) {
+        self.key = key
+        if PassiveRestoreTrace.shared.contains(key) {
+            var fields = fields()
+            fields["operationID"] = UUID().uuidString
+            fields["kind"] = kind
+            fields["queryID"] = String(RestoreTraceContext.queryID)
+            self.fields = fields
+            event("operation.submit")
+        } else { self.fields = [:] }
+    }
+    public func event(_ event: String, _ extra: [String: String] = [:]) {
+        guard !fields.isEmpty else { return }
+        PassiveRestoreTrace.shared.record(key, event, fields.merging(extra) { _, new in new })
+    }
+}
