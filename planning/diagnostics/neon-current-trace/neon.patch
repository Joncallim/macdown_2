diff --git a/Sources/RangeState/PassiveRestoreTrace.swift b/Sources/RangeState/PassiveRestoreTrace.swift
new file mode 100644
index 0000000..7395f68
--- /dev/null
+++ b/Sources/RangeState/PassiveRestoreTrace.swift
@@ -0,0 +1,172 @@
+import Foundation
+
+/// Diagnostic-only bounded recorder. Identifiers are registered explicitly by
+/// synthetic fixtures; unrelated editors and document contents are not recorded.
+public final class PassiveRestoreTrace: @unchecked Sendable {
+    public static let shared = PassiveRestoreTrace()
+    private final class Session {
+        let label: String
+        init(label: String) { self.label = label }
+        var pending: Set<String> = []
+        var rows: [[String: String]] = []
+        var bytes = 0
+        var dropped = 0
+    }
+    private let lock = NSLock()
+    private var sessions: [String: Session] = [:]
+    private var owners: [String: String] = [:]
+    private var roles: [String: String] = [:]
+    private var queryClients: [Int: String] = [:]
+    private var sequence = 0
+    private var querySequence = 0
+    private var generations: [String: Int] = [:]
+
+    public func start(view: String, label: String) -> String {
+        lock.lock(); defer { lock.unlock() }
+        let id = UUID().uuidString
+        sessions[id] = Session(label: label)
+        owners[view] = id
+        roles[view] = "edited"
+        append(id, event: "session.start", fields: ["view": view, "label": label])
+        return id
+    }
+
+    public func register(view: String, session: String, role: String) {
+        lock.lock(); defer { lock.unlock() }
+        guard sessions[session] != nil else { return }
+        owners[view] = session
+        roles[view] = role
+        append(session, event: "view.register", fields: ["view": view, "role": role])
+    }
+
+    public func bind(view: String, client: String, tree: String, callbackContext: String) {
+        lock.lock(); defer { lock.unlock() }
+        guard let owner = owners[view] else { return }
+        generations[view, default: 0] += 1
+        for key in [client, tree] { owners[key] = owner; roles[key] = roles[view] }
+        append(owner, event: "client.bind", fields: ["view": view, "client": client, "tree": tree, "callbackContext": callbackContext, "generation": String(generations[view] ?? 0),
+                                                   "role": roles[view] ?? "unknown"])
+    }
+
+    public static func ranges(_ set: IndexSet) -> String {
+        set.rangeView.map { "\($0.lowerBound)..<\($0.upperBound)" }.joined(separator: "|")
+    }
+
+    public func contains(_ key: String) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        return owners[key] != nil
+    }
+
+    public func nextQuery(view: String) -> Int {
+        lock.lock(); defer { lock.unlock() }
+        guard owners[view] != nil else { return 0 }
+        querySequence += 1
+        return querySequence
+    }
+
+    public func linkQuery(_ id: Int, client: String) {
+        guard id != 0 else { return }
+        lock.lock(); defer { lock.unlock() }
+        guard owners[client] != nil else { return }
+        guard queryClients.count < 32768 else { return }
+        queryClients[id] = client
+    }
+
+    public func record(_ key: String, _ event: String, _ fields: [String: String] = [:]) {
+        lock.lock(); defer { lock.unlock() }
+        guard let owner = owners[key] else { return }
+        var fields = fields
+        fields["identity"] = key
+        fields["role"] = roles[key] ?? "unknown"
+        if fields["queryID"] == nil, RestoreTraceContext.queryID != 0 {
+            fields["queryID"] = String(RestoreTraceContext.queryID)
+        }
+        if let id = fields["queryID"].flatMap(Int.init), let client = queryClients[id] {
+            fields["queryClient"] = client
+        }
+        append(owner, event: event, fields: fields)
+    }
+
+    public func recordQuery(_ event: String, fields: @autoclosure () -> [String: String]) {
+        let id = RestoreTraceContext.queryID
+        guard id != 0 else { return }
+        lock.lock()
+        let client = queryClients[id]
+        lock.unlock()
+        guard let client else { return }
+        record(client, event, fields().merging(["queryID": String(id)]) { _, new in new })
+    }
+
+    private func append(_ id: String, event: String, fields: [String: String]) {
+        guard let session = sessions[id] else { return }
+        if let operation = fields["operationID"] {
+            if event == "operation.submit" { session.pending.insert(operation) }
+            if event == "operation.complete" { session.pending.remove(operation) }
+        }
+        if let query = fields["queryID"], query != "0" {
+            if event == "query.begin" { session.pending.insert("query-" + query) }
+            if event == "query.end" { session.pending.remove("query-" + query) }
+        }
+        var row = fields
+        sequence += 1
+        row["sequence"] = String(sequence)
+        row["uptime"] = String(DispatchTime.now().uptimeNanoseconds)
+        row["event"] = event
+        let bytes = row.reduce(0) { $0 + $1.key.utf8.count + $1.value.utf8.count }
+        if session.rows.count < 32768 && session.bytes + bytes <= 16 * 1024 * 1024 {
+            session.rows.append(row)
+            session.bytes += bytes
+        } else {
+            session.dropped += 1
+        }
+    }
+
+    /// Snapshot and unregister before serializing. This marks a collection
+    /// boundary; it does not claim that the editor's asynchronous work drained.
+    public func finish(_ id: String, directory: String) throws {
+        lock.lock()
+        append(id, event: "session.finish", fields: [:])
+        let session = sessions.removeValue(forKey: id)
+        let keys = Set(owners.filter { $0.value == id }.map(\.key))
+        owners = owners.filter { $0.value != id }
+        generations = generations.filter { !keys.contains($0.key) }
+        roles = roles.filter { !keys.contains($0.key) }
+        queryClients = queryClients.filter { !keys.contains($0.value) }
+        lock.unlock()
+        guard let session else { return }
+        let body: [String: Any] = ["schema": 2, "processID": ProcessInfo.processInfo.processIdentifier, "session": id, "label": session.label,
+                                  "droppedEvents": session.dropped, "payloadBytes": session.bytes,
+                                  "collectionEnded": true, "pendingObservedWork": session.pending.sorted(),
+                                  "quiescenceAsserted": false, "events": session.rows]
+        let data = try JSONSerialization.data(withJSONObject: body, options: [.sortedKeys])
