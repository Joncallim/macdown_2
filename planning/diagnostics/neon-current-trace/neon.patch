@@ -0,0 +1,98 @@
+import AppKit
+import CryptoKit
+import Foundation
+import RangeState
+
+/// Public facade used only by the copied synthetic test fixture.
+@MainActor
+public enum RestoreHostedTrace {
+    private static var pendingRegistration: (String, String)?
+    private static var readers: [String: @MainActor (NSTextView) -> [String: String]] = [:]
+    private static var viewSessions: [String: String] = [:]
+
+    public static func begin(view: NSTextView, label: String, reader: @escaping @MainActor (NSTextView) -> [String: String]) -> String? {
+        guard ProcessInfo.processInfo.environment["MOSTLYTEXT_RESTORE_TRACE_DIR"] != nil else { return nil }
+        let session = PassiveRestoreTrace.shared.start(view: identity(view), label: label)
+        readers[session] = reader
+        viewSessions[identity(view)] = session
+        return session
+    }
+
+    public static func withRegistration<T>(_ session: String?, role: String, body: () -> T) -> T {
+        guard let session else { return body() }
+        precondition(pendingRegistration == nil)
+        pendingRegistration = (session, role)
+        defer { pendingRegistration = nil }
+        return body()
+    }
+
+    static func registerPending(view: NSTextView) {
+        guard let (session, role) = pendingRegistration else { return }
+        PassiveRestoreTrace.shared.register(view: identity(view), session: session, role: role)
+        viewSessions[identity(view)] = session
+        pendingRegistration = nil
+    }
+
+    public static func identity(_ object: AnyObject) -> String { String(describing: ObjectIdentifier(object)) }
+
+    public static func state(_ view: NSTextView) -> [String: String] {
+        guard PassiveRestoreTrace.shared.contains(identity(view)) else { return [:] }
+        return ["view": identity(view), "length": String(view.string.utf16.count),
+                "textSHA256": SHA256.hash(data: Data(view.string.utf8)).map { String(format: "%02x", $0) }.joined(),
+                "storageVersion": String(view.textStorage?.hashValue ?? 0)]
+    }
+
+    public static func record(view: NSTextView, event: String, fields: @autoclosure () -> [String: String] = [:]) {
+        let key = identity(view)
+        guard PassiveRestoreTrace.shared.contains(key) else { return }
+        var fields = fields()
+        fields.merge(state(view)) { _, new in new }
+        PassiveRestoreTrace.shared.record(key, event, fields)
+    }
+
+    public static func digest(_ value: String) -> String {
+        SHA256.hash(data: Data(value.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func attributeSignature(_ attributes: [NSAttributedString.Key: Any]) -> String {
+        var parts: [String] = []
+        if let color = (attributes[.foregroundColor] as? NSColor)?.usingColorSpace(.sRGB) {
+            parts.append(String(format: "c%02x%02x%02x", Int(color.redComponent * 255),
+                                Int(color.greenComponent * 255), Int(color.blueComponent * 255)))
+        }
+        if let font = attributes[.font] as? NSFont {
+            let traits = font.fontDescriptor.symbolicTraits
+            parts.append("f\(traits.contains(.bold) ? "b" : "")\(traits.contains(.italic) ? "i" : "")")
+        }
+        if attributes[.underlineStyle] != nil { parts.append("u") }
+        return parts.joined(separator: ",")
+    }
+
+    /// The macOS 26 test target supplies a read-only attribute reader. Keeping
+    /// it there preserves the pinned dependency's original deployment target.
+    static func rendering(_ view: NSTextView, event: String, queryID: Int) {
+        guard let session = viewSessions[identity(view)], let reader = readers[session] else { return }
+        var fields = reader(view)
+        fields["queryID"] = String(queryID)
+        record(view: view, event: event, fields: fields)
+    }
+
+    static func application(_ value: TokenApplication) -> [String: String] {
+        let tokens = value.tokens.map { "\($0.name):\(NSStringFromRange($0.range))" }.joined(separator: "|")
+        return ["action": String(describing: value.action), "clearRange": value.range.map(NSStringFromRange) ?? "nil",
+                "tokenCount": String(value.tokens.count), "tokens": tokens, "tokensSHA256": digest(tokens)]
+    }
+
+    static func namedRanges(_ value: String, range: NSRange, version: String) -> [String: String] {
+        ["range": NSStringFromRange(range), "clientVersion": version,
+         "namedRanges": value, "namedRangesSHA256": digest(value)]
+    }
+
+    public static func finish(_ session: String?) {
+        guard let session, let directory = ProcessInfo.processInfo.environment["MOSTLYTEXT_RESTORE_TRACE_DIR"] else { return }
+        readers.removeValue(forKey: session)
+        viewSessions = viewSessions.filter { $0.value != session }
+        do { try PassiveRestoreTrace.shared.finish(session, directory: directory) }
+        catch { print("RESTORE_TRACE_WRITE_FAILED: \(String(reflecting: type(of: error)))") }
+    }
+}
