+/// Observes Dispatch timer delivery without competing with the Swift cleanup gate.
+private final class NativeCleanupTimerProbe: @unchecked Sendable {
+    private let timer: DispatchSourceTimer
+
+    init(probe: BlockingCancellationProbe) {
+        timer = DispatchSource.makeTimerSource(
+            queue: DispatchQueue(label: "mostlytext.cleanup.timer-observer", qos: .userInitiated)
+        )
+        timer.setEventHandler { probe.record(.nativeTimerFired) }
+        timer.schedule(deadline: .distantFuture)
+        timer.resume()
+    }
+
+    func arm(probe: BlockingCancellationProbe) {
+        timer.schedule(deadline: .now() + .milliseconds(25), leeway: .nanoseconds(0))
+        probe.record(.nativeTimerArmed)
+    }
+
+    func cancel() {
+        timer.cancel()
+    }
+}
+
