diff --git a/MacDownKit/Tests/HighlightingTests/RestoreHostedTraceSupport.swift b/MacDownKit/Tests/HighlightingTests/RestoreHostedTraceSupport.swift
new file mode 100644
index 00000000..1b906b0c
--- /dev/null
+++ b/MacDownKit/Tests/HighlightingTests/RestoreHostedTraceSupport.swift
@@ -0,0 +1,59 @@
+import AppKit
+@testable import Highlighting
+import Neon
+
+@MainActor
+func restoreTraceState(_ editor: HighlightedEditor, stage: String, fields: [String: String] = [:]) {
+    var fields = fields
+    fields["stage"] = stage
+    fields["mode"] = String(describing: editor.mode)
+    fields["contentRevision"] = String(editor.system.contentRevision)
+    fields["generation"] = String(editor.highlighter.generation)
+    fields["styledTokenCount"] = String(editor.highlighter.styledTokenCount)
+    RestoreHostedTrace.record(view: editor.textView, event: "fixture.state", fields: fields)
+}
+
+@MainActor
+func restoreTraceRuns(
+    _ editor: HighlightedEditor, stage: String, observed: [RenderedRun], reference: [RenderedRun],
+    initialReference: [RenderedRun], originalMatches: Bool? = nil
+) {
+    restoreTraceState(editor, stage: stage)
+    let observedText = observed.map(\.description).joined(separator: "|")
+    let referenceText = reference.map(\.description).joined(separator: "|")
+    let initialText = initialReference.map(\.description).joined(separator: "|")
+    RestoreHostedTrace.record(view: editor.textView, event: "fixture.runs", fields: [
+        "stage": stage, "matches": String(observed == reference),
+        "originalComparisonMatches": originalMatches.map(String.init) ?? "notPrimary",
+        "readOrder": "afterPrimaryAssertion", "referenceUnchanged": String(reference == initialReference),
+        "observed": observedText, "reference": referenceText,
+        "observedSHA256": RestoreHostedTrace.digest(observedText),
+        "referenceSHA256": RestoreHostedTrace.digest(referenceText),
+        "initialReferenceSHA256": RestoreHostedTrace.digest(initialText),
+    ])
+}
+
+/// Reads only existing TextKit 2 rendering attributes. It neither forces layout
+/// nor invokes the highlighter's attribute provider, and is not a pixel oracle.
+@MainActor
+func restoreTraceRendering(_ view: NSTextView) -> [String: String] {
+    guard let layout = view.textLayoutManager, let content = layout.textContentManager else {
+        return ["renderingAvailable": "false"]
+    }
+    let origin = content.documentRange.location
+    var runs: [RenderedRun] = []
+    layout.enumerateRenderingAttributes(from: origin, reverse: false) { _, attributes, range in
+        let location = content.offset(from: origin, to: range.location)
+        let length = content.offset(from: range.location, to: range.endLocation)
+        let signature = RenderedRun.signature(of: attributes)
+        guard !signature.isEmpty, length > 0 else { return true }
+        if let last = runs.last, last.signature == signature, NSMaxRange(last.range) == location {
+            runs[runs.count - 1].range.length += length
+        } else {
+            runs.append(RenderedRun(range: NSRange(location: location, length: length), signature: signature))
+        }
+        return true
+    }
+    let value = runs.map(\.description).joined(separator: "|")
+    return ["renderingAvailable": "true", "renderedRuns": value, "renderedSHA256": RestoreHostedTrace.digest(value)]
+}
