new file mode 100644
index 0000000..f30842d
--- /dev/null
+++ b/Sources/SwiftTreeSitterLayer/DiagTrace.swift
@@ -0,0 +1,59 @@
+import Foundation
+import SwiftTreeSitter
+
+/// DIAG SCRATCH ONLY: appends trace lines to the file named by DIAG_TRACE while `enabled`.
+public enum DiagTrace {
+	nonisolated(unsafe) public static var enabled = false
+	nonisolated(unsafe) public static var tag = ""
+	nonisolated(unsafe) public static var rootLayers: [LanguageLayer] = []
+	private static let lock = NSLock()
+	private static let handle: FileHandle? = {
+		guard let path = ProcessInfo.processInfo.environment["DIAG_TRACE"] else { return nil }
+		FileManager.default.createFile(atPath: path, contents: nil)
+		return FileHandle(forWritingAtPath: path)
+	}()
+
+	public static func log(_ message: @autoclosure () -> String) {
+		guard enabled, let handle else { return }
+		let line = "[\(tag)] " + message() + "\n"
+		lock.withLock { handle.write(line.data(using: .utf8)!) }
+	}
+
+	public static func ranges(_ set: IndexSet) -> String {
+		let r = set.rangeView.map { "\($0.lowerBound)..<\($0.upperBound)" }
+		return r.count > 12 ? "\(r.count) ranges [" + r.prefix(6).joined(separator: ",") + " ... " + r.suffix(3).joined(separator: ",") + "]" : "[" + r.joined(separator: ",") + "]"
+	}
+
+	public static func edit(_ e: InputEdit) -> String {
+		"start=\(e.startByte / 2)@\(e.startPoint.row):\(e.startPoint.column) oldEnd=\(e.oldEndByte / 2)@\(e.oldEndPoint.row):\(e.oldEndPoint.column) newEnd=\(e.newEndByte / 2)@\(e.newEndPoint.row):\(e.newEndPoint.column)"
+	}
+}
+
+extension LanguageLayer {
+	/// DIAG: the current tree of `name` (self or a direct sublayer).
+	public func diagTree(_ name: String) -> MutableTree? {
+		if languageName == name { return state.tree }
+		return diagSublayer(name)?.state.tree
+	}
+
+	public func diagSublayer(_ name: String) -> LanguageLayer? {
+		diagSublayers[name]
+	}
+}
+
+/// DIAG: the root-layer calls Neon makes, with the exact text each one read.
+public enum DiagEvent {
+	case edit(InputEdit, text: String)
+	case resolve(IndexSet, text: String)
+}
+
+extension DiagTrace {
+	nonisolated(unsafe) public static var recording = false
+	nonisolated(unsafe) public static var events: [DiagEvent] = []
+
+	public static func read(_ content: LanguageLayer.Content) -> String {
+		var data = Data()
+		while let chunk = content.readHandler(data.count, .zero), chunk.count > 0 { data.append(chunk) }
+		return String(data: data, encoding: .utf16LittleEndian) ?? ""
+	}
+}
