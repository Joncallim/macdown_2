From 90ec529441c85657c484ac5da77f61f6645799e7 Mon Sep 17 00:00:00 2001
From: Joncallim <64296013+Joncallim@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:59:40 +0800
Subject: [PATCH 1/3] Replace sublayer ranges within the resolved set, so lazy
 resolution matches a fresh parse

resolveSublayers(with:in:) merged the injections it found into a sublayer's
existing ranges but never removed one. Resolving only part of a document (the
set an edit invalidated) left behind ranges whose injection had vanished, and a
new range overlapping an old one replaced it although the old one still
covered injections outside the set.

- Resolve every existing sublayer range the set touches as a whole.
- Remove existing ranges in the set that the query did not find again, and
  ranges an edit collapsed to zero length inside the set; a sublayer with no
  injections left in the set loses its ranges there too.
- Skip the reparse when the merged ranges equal the current ones (the parse
  done for the edit already holds), so resolving after an ordinary keystroke
  does not reparse the sublayer a second time.
---
 .../SwiftTreeSitterLayer/LanguageLayer.swift  | 50 +++++++++++++++++--
 .../LanguageLayerTests.swift                  | 48 ++++++++++++++++--
 2 files changed, 90 insertions(+), 8 deletions(-)

diff --git a/Sources/SwiftTreeSitterLayer/LanguageLayer.swift b/Sources/SwiftTreeSitterLayer/LanguageLayer.swift
index 9272812..541aaab 100644
--- a/Sources/SwiftTreeSitterLayer/LanguageLayer.swift
+++ b/Sources/SwiftTreeSitterLayer/LanguageLayer.swift
@@ -333,19 +333,43 @@ extension LanguageLayer {
 		return layer.parse(with: content, affecting: affectedSet, resolveSublayers: true)
 	}
 
-	private func encorporateRanges(_ tsRanges: [TSRange], content: Content) throws -> IndexSet {
-		guard let includedRanges = state.tree?.includedRanges else {
+	/// Incorporate the ranges injections resolved to within `resolvedSet`.
+	///
+	/// Every existing range that intersects `resolvedSet` was queried again, so one that `tsRanges` does not contain no longer exists and is removed, as is a range an edit collapsed to zero length inside the set.
+	private func encorporateRanges(_ tsRanges: [TSRange], resolvedSet: IndexSet, content: Content) throws -> IndexSet {
+		guard let currentRanges = state.tree?.includedRanges else {
 			preconditionFailure("Cannot encorporateRanges into a layer that doesn't have any already defined")
 		}
 
 		var invalidation = IndexSet()
 
+		let includedRanges = currentRanges.filter { range in
+			guard let r = Range(range.bytes.range) else { return true }
+
+			if r.isEmpty {
+				return resolvedSet.contains(r.lowerBound) == false
+			}
+
+			guard resolvedSet.intersects(integersIn: r), tsRanges.contains(where: { $0.bytes == range.bytes }) == false else { return true }
+
+			invalidation.insert(integersIn: r)
+
+			return false
+		}
+
 		for newTSRange in tsRanges {
 			invalidation.insert(integersIn: Range(newTSRange.bytes.range)!)
 		}
 
+		let merged = Self.mergeIncludedRanges(includedRanges, with: tsRanges)
+
+		// unchanged ranges: the parse done for the edit already holds
+		if merged.map(\.bytes) == currentRanges.map(\.bytes) {
+			return IndexSet()
+		}
+
 		// if tree-sitter rejects them, the parser keeps its current ranges, so report that instead of reparsing
-		guard parser.setIncludedRanges(Self.mergeIncludedRanges(includedRanges, with: tsRanges)) else {
+		guard parser.setIncludedRanges(merged) else {
 			throw LanguageLayerError.includedRangesRejected(languageName)
 		}
 
@@ -419,6 +443,17 @@ extension LanguageLayer {
 			return IndexSet()
 		}
 
+		// an existing sublayer range the set touches is resolved as a whole, so ranges it still needs outside the set are found again
+		var set = set
+
+		for sublayer in sublayers.values {
+			for range in sublayer.state.tree?.includedRanges ?? [] {
+				guard let r = Range(range.bytes.range), r.isEmpty == false, set.intersects(integersIn: r) else { continue }
+
+				set.insert(integersIn: r)
+			}
+		}
+
 		// injections must be shallow
 		let injections = try executeShallowQuery(.injections, in: set).injections(with: content.textProvider)
 		let groupedInjections = Dictionary(grouping: injections, by: { $0.name })
@@ -437,9 +472,14 @@ extension LanguageLayer {
 				continue
 			}
 
-			let set = try sublayer.encorporateRanges(ranges, content: content)
+			let subset = try sublayer.encorporateRanges(ranges, resolvedSet: set, content: content)
+
+			invalidations.formUnion(subset)
+		}
 
-			invalidations.formUnion(set)
+		// a sublayer with no injections left in the set loses its ranges there
+		for (name, sublayer) in sublayers where groupedInjections[name] == nil && sublayer.state.tree != nil {
+			invalidations.formUnion(try sublayer.encorporateRanges([], resolvedSet: set, content: content))
 		}
 
 		return invalidations
diff --git a/Tests/SwiftTreeSitterLayerTests/LanguageLayerTests.swift b/Tests/SwiftTreeSitterLayerTests/LanguageLayerTests.swift
index 7c4cccb..26c92d5 100644
--- a/Tests/SwiftTreeSitterLayerTests/LanguageLayerTests.swift
+++ b/Tests/SwiftTreeSitterLayerTests/LanguageLayerTests.swift
@@ -315,7 +315,8 @@ let a = "var a = 1"
 		}
 	}
 
-	private func assertInjectionsMatchFreshParse(text: String, editRange: Range<Int>, replacement: String, file: StaticString = #filePath, line: UInt = #line) throws {
+	/// - Parameter invalidatedOnly: resolve sublayers only over the set the edit invalidated (plus the edit point), as an editor resolving lazily does, instead of the whole document.
+	private func assertInjectionsMatchFreshParse(text: String, editRange: Range<Int>, replacement: String, invalidatedOnly: Bool = false, file: StaticString = #filePath, line: UInt = #line) throws {
 		let config = LanguageLayer.Configuration(languageProvider: { _ in Self.swiftConfig })
 
 		func point(_ string: String, _ location: Int) -> Point {
@@ -343,8 +344,9 @@ let a = "var a = 1"
 		let content = LanguageLayer.Content(string: newText)
 		let fullSet = IndexSet(integersIn: 0..<newText.utf16.count)
 
-		_ = layer.didChangeContent(content, using: edit, resolveSublayers: false)
-		_ = try layer.resolveSublayers(with: content, in: fullSet)
+		var invalidated = layer.didChangeContent(content, using: edit, resolveSublayers: false)
+		invalidated.insert(integersIn: max(0, editRange.lowerBound - 1)..<min(newText.utf16.count, newEnd + 1))
+		_ = try layer.resolveSublayers(with: content, in: invalidatedOnly ? invalidated : fullSet)
 
 		let fresh = try LanguageLayer(languageConfig: Self.selfInjectingSwiftConfig, configuration: config)
 		fresh.replaceContent(with: newText)
@@ -382,6 +384,46 @@ let c = "var c = 1"
 		try assertInjectionsMatchFreshParse(text: text, editRange: 12..<39, replacement: " x = 2\"\nlet b = \"var y = 3\"")
 	}
 
+	func testReplacementSpanningInjectionsResolvingOnlyTheInvalidatedSet() throws {
+		let text = """
+let a = "var a = 1"
+let b = "var b = 1"
+let c = "var c = 1"
+"""
+
+		try assertInjectionsMatchFreshParse(text: text, editRange: 12..<39, replacement: " x = 2\"\nlet b = \"var y = 3\"", invalidatedOnly: true)
+	}
+
+	func testSplittingAnInjectionResolvingOnlyTheInvalidatedSet() throws {
+		let text = """
+let a = "var a = 1; var b = 2"
+"""
+
+		// the string ends inside the old injection, which a new string after it overlaps: the head must be found again
+		try assertInjectionsMatchFreshParse(text: text, editRange: 18..<18, replacement: "\" + \"", invalidatedOnly: true)
+	}
+
+	func testVanishedInjectionResolvingOnlyTheInvalidatedSet() throws {
+		let text = """
+let a = "var a = 1"
+let b = 2
+"""
+
+		// no string, so no injection, is left: its range must go although nothing new replaces it
+		try assertInjectionsMatchFreshParse(text: text, editRange: 8..<19, replacement: "3", invalidatedOnly: true)
+	}
+
+	func testDeletedInjectionResolvingOnlyTheInvalidatedSet() throws {
+		let text = """
+let a = "var a = 1"
+let b = "var b = 1"
+let c = 3
+"""
+
+		// the whole second line goes: its range collapses to zero length at the deletion point
+		try assertInjectionsMatchFreshParse(text: text, editRange: 20..<40, replacement: "", invalidatedOnly: true)
+	}
+
 	func testMergeIncludedRanges() {
 		func range(_ bytes: Range<UInt32>) -> TSRange {
 			TSRange(points: Point(0, Int(bytes.lowerBound))..<Point(0, Int(bytes.upperBound)), bytes: bytes)
