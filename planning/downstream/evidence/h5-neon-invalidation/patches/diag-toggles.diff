diff --git a/Tests/RangeStateTests/RangeInvalidationBufferTests.swift b/Tests/RangeStateTests/RangeInvalidationBufferTests.swift
new file mode 100644
index 0000000..4824a41
--- /dev/null
+++ b/Tests/RangeStateTests/RangeInvalidationBufferTests.swift
@@ -0,0 +1,90 @@
+import Foundation
+import Testing
+
+import RangeState
+
+struct RangeInvalidationBufferTests {
+	private func flushed(_ buffered: IndexSet, change range: NSRange, delta: Int) -> RangeTarget? {
+		let buffer = RangeInvalidationBuffer()
+		var delivered: RangeTarget?
+
+		buffer.invalidationHandler = { delivered = $0 }
+
+		buffer.beginBuffering()
+		buffer.invalidate(.set(buffered))
+		buffer.contentChanged(in: range, delta: delta)
+		buffer.endBuffering()
+
+		return delivered
+	}
+
+	@Test func changeAfterBufferedRangeLeavesIt() {
+		#expect(flushed(IndexSet(integersIn: 10..<20), change: NSRange(30..<35), delta: -5) == .set(IndexSet(integersIn: 10..<20)))
+		#expect(flushed(IndexSet(integersIn: 10..<20), change: NSRange(20..<20), delta: 3) == .set(IndexSet(integersIn: 10..<20)))
+	}
+
+	@Test func changeBeforeBufferedRangeShiftsIt() {
+		#expect(flushed(IndexSet(integersIn: 100..<110), change: NSRange(10..<10), delta: 5) == .set(IndexSet(integersIn: 105..<115)))
+		#expect(flushed(IndexSet(integersIn: 100..<110), change: NSRange(10..<60), delta: -50) == .set(IndexSet(integersIn: 50..<60)))
+	}
+
+	@Test func deletionOverlappingTheStartKeepsTheSurvivingTail() {
+		// 105..<110 survives, at 90..<95
+		#expect(flushed(IndexSet(integersIn: 100..<110), change: NSRange(90..<105), delta: -15) == .set(IndexSet(integersIn: 90..<95)))
+	}
+
+	@Test func deletionOverlappingTheEndKeepsTheSurvivingHead() {
+		#expect(flushed(IndexSet(integersIn: 100..<110), change: NSRange(105..<115), delta: -10) == .set(IndexSet(integersIn: 100..<105)))
+	}
+
+	@Test func replacementInsideCoversTheReplacementText() {
+		#expect(flushed(IndexSet(integersIn: 100..<110), change: NSRange(102..<104), delta: 3) == .set(IndexSet(integersIn: 100..<113)))
+	}
+
+	@Test func deletingTheWholeRangeDropsIt() {
+		#expect(flushed(IndexSet(integersIn: 100..<110), change: NSRange(90..<120), delta: -30) == .set(IndexSet()))
+	}
+
+	@Test func allStaysAll() {
+		let buffer = RangeInvalidationBuffer()
+		var delivered: RangeTarget?
+
+		buffer.invalidationHandler = { delivered = $0 }
+
+		buffer.beginBuffering()
+		buffer.invalidate(.all)
+		buffer.contentChanged(in: NSRange(0..<10), delta: -10)
+		buffer.endBuffering()
+
+		#expect(delivered == .all)
+	}
+
+	@Test func invalidationsAfterTheChangeAreNotTransformed() {
+		let buffer = RangeInvalidationBuffer()
+		var delivered: RangeTarget?
+
+		buffer.invalidationHandler = { delivered = $0 }
+
+		buffer.beginBuffering()
+		buffer.invalidate(.set(IndexSet(integersIn: 100..<110)))
+		buffer.beginBuffering()
+		buffer.contentChanged(in: NSRange(0..<50), delta: -50)
+		buffer.invalidate(.set(IndexSet(integersIn: 0..<5)))
+		buffer.endBuffering()
+		buffer.endBuffering()
+
+		#expect(delivered == .set(IndexSet(integersIn: 0..<5).union(IndexSet(integersIn: 50..<60))))
+	}
+
+	@Test func changeWhileIdleIsIgnored() {
+		let buffer = RangeInvalidationBuffer()
+		var delivered: [RangeTarget] = []
+
+		buffer.invalidationHandler = { delivered.append($0) }
+
+		buffer.contentChanged(in: NSRange(0..<10), delta: -10)
+		buffer.invalidate(.set(IndexSet(integersIn: 0..<5)))
+
+		#expect(delivered == [.set(IndexSet(integersIn: 0..<5))])
+	}
+}
