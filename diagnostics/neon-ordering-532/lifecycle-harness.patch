diff --git a/Tests/HighlightingTests/MarkdownLifecycleOrderingDiagnosticTests.swift b/Tests/HighlightingTests/MarkdownLifecycleOrderingDiagnosticTests.swift
new file mode 100644
--- /dev/null
+++ b/Tests/HighlightingTests/MarkdownLifecycleOrderingDiagnosticTests.swift
@@ -0,0 +1,35 @@
+import Darwin
+import Foundation
+import RangeState
+import Testing
+
+enum MarkdownOrderingDiagnosticContext {
+    @TaskLocal static var trace: OrderingTrace?
+
+    static func mark(_ phase: String) {
+        FileHandle.standardError.write(Data("NEON_SEQUENCE pid=\(getpid()) phase=\(phase) gates=unset\n".utf8))
+    }
+}
+
+/// Calls the existing methods in order. No new sleeps, drains, cancellation or teardown.
+@MainActor
+@Suite(.serialized)
+struct MarkdownLifecycleOrderingDiagnosticTests {
+    @Test func restoreLifetimesThenOriginalBelowCutoff() async {
+        let trace = OrderingTrace(capacity: 4096)
+        await MarkdownOrderingDiagnosticContext.$trace.withValue(trace) {
+            MarkdownOrderingDiagnosticContext.mark("restore-start")
+            await HighlightingSizeFallbackTests().shrinkingBelowTheRestoreThresholdRestoresOnlyAfterIdle(includesIdlePause: false)
+            await HighlightingSizeFallbackTests().shrinkingBelowTheRestoreThresholdRestoresOnlyAfterIdle(includesIdlePause: true)
+            await HighlightingSizeFallbackTests().controlledIdleClockRejectsEarlyRestoreAndJoinsDueWaiters(includesIdlePause: false)
+            await HighlightingSizeFallbackTests().controlledIdleClockRejectsEarlyRestoreAndJoinsDueWaiters(includesIdlePause: true)
+            MarkdownOrderingDiagnosticContext.mark("restore-returned")
+            MarkdownOrderingDiagnosticContext.mark("original-start")
+            await HighlightingSizeFallbackTests().belowTheCutoffHighlightingMatchesAFreshHighlighter()
+            MarkdownOrderingDiagnosticContext.mark("original-returned")
+        }
+        MarkdownOrderingDiagnosticContext.mark("sequence-returned")
+        OrderingContext(trace: trace).dump()
+        #expect(trace.snapshot().evicted == 0)
+    }
+}
