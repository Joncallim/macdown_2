+        let events = trace.snapshot().events
+        let retirement = try #require(events.first { $0.processor == fixture.processor && $0.phase == .retired })
+        #expect(events.contains { $0.fixture == fixture.fixture && $0.phase == .callback && $0.sequence > retirement.sequence })
