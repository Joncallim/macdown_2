+        #expect(values[2] == (reverseSubmission ? "aYcd" : "XYbcd"))
+        #expect(!processor.hasPendingWork)
+        let events = trace.snapshot().events
+        #expect(events.filter { $0.phase == .execute }.map(\.operation) == [query] + workerOrder)
+        #expect(events.filter { $0.phase == .callback }.map(\.operation) == [query, b, a])
+        #expect(events.filter { $0.phase == .callback }.allSatisfy { $0.retainedDeliveryCount == 1 })
