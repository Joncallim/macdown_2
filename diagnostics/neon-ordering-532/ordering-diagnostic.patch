+    @Test func rangeProcessorAndClientShareOperationAndLifetimeMetadata() throws {
+        let trace = OrderingTrace()
+        let fixture = OrderingContext(trace: trace)
+        let source = "func main() {}\n"
+        let query = try Query(language: Language(tree_sitter_swift()), data: Data("(\"func\" @keyword)".utf8))
+        let language = LanguageConfiguration(tree_sitter_swift(), name: "Swift", queries: [.highlights: query])
+        let config = TreeSitterClient.Configuration(
+            contentSnapshopProvider: { _ in .init(string: source) },
+            lengthProvider: { source.utf16.count }, invalidationHandler: { _ in },
+            locationTransformer: { offset in Point(row: 0, column: offset * 2) })
+        // The same fixture creates two client lifetimes, e.g. after a rebuild.
+        for _ in 0..<2 {
+            let client = try TreeSitterClient(rootLanguageConfig: language, configuration: config, orderingContext: fixture)
+            let matches = try client.highlights(in: NSRange(location: 0, length: 4),
+                provider: source.predicateTextProvider, mode: .required)
+            #expect(matches?.count == 1)
+        }
+        let events = trace.snapshot().events
+        let enqueues = events.filter { $0.phase == .enqueue }
+        #expect(enqueues.count == 2)
+        #expect(Set(enqueues.map(\.client)).count == 2, "rebuilt clients must not share a client lifetime ID")
+        #expect(enqueues.allSatisfy { $0.fixture == fixture.fixture })
+        for enqueue in enqueues {
+            let callback = events.first { $0.phase == .callback && $0.operation == enqueue.operation }
+            let request = events.first { $0.phase == .request && $0.parent == enqueue.operation }
+            #expect(callback?.processor == enqueue.processor)
+            #expect(request?.client == enqueue.client)
+            #expect(request?.fixture == fixture.fixture)
+            #expect(request?.processor != enqueue.processor)
+            #expect(events.contains { $0.phase == .compare && $0.operation == enqueue.operation && $0.expected == enqueue.parent })
+        }
+    }
