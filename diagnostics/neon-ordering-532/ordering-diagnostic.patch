diff --git a/Sources/RangeState/OrderingTrace.swift b/Sources/RangeState/OrderingTrace.swift
new file mode 100644
index 0000000..5838071
--- /dev/null
+++ b/Sources/RangeState/OrderingTrace.swift
@@ -0,0 +1,118 @@
+import Foundation
+
+/// Explicitly supplied by a diagnostic fixture. Never records document text.
+public final class OrderingTrace: @unchecked Sendable {
+    public enum Phase: String, Sendable {
+        case born, retired, enqueue, request, submit, execute, executed, resume, callback, compare
+    }
+
+    public struct Event: Sendable {
+        public let sequence: UInt64
+        public let fixture: UUID
+        public let client: UUID
+        public let processor: UUID
+        public let phase: Phase
+        public let operation: UInt64
+        public let parent: UInt64
+        public let expected: UInt64
+        public let pending: Int
+        public let range: NSRange
+        public let delta: Int
+        public let limit: Int
+        /// Exact within the retained trace window; eviction is explicit.
+        public let retainedDeliveryCount: Int
+    }
+
+    private let lock = NSLock()
+    private var slots: [Event?]
+    private var cursor = 0
+    private var serial: UInt64 = 0
+    private var operationSerial: UInt64 = 0
+    public let capacity: Int
+
+    public init(capacity: Int = 256) {
+        precondition((16...4096).contains(capacity))
+        self.capacity = capacity
+        slots = Array(repeating: nil, count: capacity)
+    }
+
+    public func nextOperation() -> UInt64 {
+        lock.lock()
+        defer { lock.unlock() }
+        operationSerial += 1
+        return operationSerial
+    }
+
+    public func snapshot() -> (events: [Event], evicted: UInt64) {
+        lock.lock()
+        defer { lock.unlock() }
+        return (slots.compactMap { $0 }.sorted { $0.sequence < $1.sequence },
+                serial > UInt64(capacity) ? serial - UInt64(capacity) : 0)
+    }
+
+    fileprivate func append(_ context: OrderingContext, _ phase: Phase, operation: UInt64,
+                            parent: UInt64, expected: UInt64, pending: Int,
+                            range: NSRange, delta: Int, limit: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        var deliveries = 0
+        if phase == .callback {
+            deliveries = 1
+            for (index, entry) in slots.enumerated() where index != cursor {
+                if let entry, entry.processor == context.processor,
+                   entry.operation == operation, entry.phase == .callback { deliveries += 1 }
+            }
+        }
+        serial += 1
+        slots[cursor] = Event(sequence: serial, fixture: context.fixture, client: context.client,
+                              processor: context.processor, phase: phase, operation: operation,
+                              parent: parent, expected: expected, pending: pending, range: range,
+                              delta: delta, limit: limit, retainedDeliveryCount: deliveries)
+        cursor = (cursor + 1) % capacity
+    }
+}
+
+public struct OrderingContext: Sendable {
+    public let trace: OrderingTrace
+    public let fixture: UUID
+    public let client: UUID
+    public let processor: UUID
+
+    public init(trace: OrderingTrace, fixture: UUID = UUID(), client: UUID = UUID(), processor: UUID = UUID()) {
+        self.trace = trace
+        self.fixture = fixture
+        self.client = client
+        self.processor = processor
+    }
+
+    public func childProcessor() -> Self {
+        Self(trace: trace, fixture: fixture, client: client)
+    }
+
+    /// Each rebuilt client keeps fixture provenance but receives a fresh lifetime.
+    public func newClient() -> Self {
+        Self(trace: trace, fixture: fixture)
+    }
+
+    public func record(_ phase: OrderingTrace.Phase, operation: UInt64 = 0, parent: UInt64 = 0,
+                       expected: UInt64 = 0, pending: Int = -1, range: NSRange = NSRange(location: 0, length: 0),
+                       delta: Int = 0, limit: Int = -1) {
+        trace.append(self, phase, operation: operation, parent: parent, expected: expected,
+                     pending: pending, range: range, delta: delta, limit: limit)
+    }
+
+    /// Only invoked on an invariant failure, before queue consumption.
+    public func dump() {
+        let snapshot = trace.snapshot()
+        var lines = ["NEON_ORDER_TRACE evicted=\(snapshot.evicted) capacity=\(trace.capacity)"]
+        for e in snapshot.events {
+            lines.append("NEON_ORDER \(e.sequence) fixture=\(e.fixture) client=\(e.client) processor=\(e.processor) "
+                  + "phase=\(e.phase.rawValue) op=\(e.operation) parent=\(e.parent) expected=\(e.expected) "
+                  + "pending=\(e.pending) range=\(e.range.location):\(e.range.length) delta=\(e.delta) "
+                  + "limit=\(e.limit) retainedDeliveries=\(e.retainedDeliveryCount)")
+        }
+        // snapshot() has already released the ring lock. FileHandle.write is
+        // synchronous and avoids stdout buffering immediately before a trap.
+        FileHandle.standardError.write(Data((lines.joined(separator: "\n") + "\n").utf8))
+    }
+}
