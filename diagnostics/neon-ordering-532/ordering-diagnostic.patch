+    private func until(_ condition: () -> Bool) async -> Bool {
+        let clock = ContinuousClock()
+        let deadline = clock.now + .seconds(3)
+        while !condition(), clock.now < deadline { await Task.yield() }
+        return condition()
+    }
+}
+
+@MainActor
+private final class HeldCalls {
+    private var calls: [(UInt64, () -> Void)] = []
+    var ids: [UInt64] { calls.map { $0.0 } }
+    func hold(_ id: UInt64, _ action: @escaping () -> Void) { calls.append((id, action)) }
+    func release(_ id: UInt64) {
+        guard let index = calls.firstIndex(where: { $0.0 == id }) else { Issue.record("missing held call"); return }
+        let action = calls.remove(at: index).1
+        action()
+    }
+    func releaseAll() { while let first = calls.first { release(first.0) } }
+}
+
+/// Mutated only on BackgroundProcessor's serial worker; lock permits fixture reads.
+private final class SnapshotLedger: @unchecked Sendable {
+    private let lock = NSLock()
+    private var text = "abcd"
+    private var edits: [Int] = []
+    private var checks: [Bool] = []
+    var snapshot: String { lock.withLock { String(text) } }
+    var applied: [Int] { lock.withLock { edits } }
+    var snapshotChecks: [Bool] { lock.withLock { checks } }
+    func apply(_ id: Int, range: NSRange, replacement: String, expected: String) -> String {
+        lock.withLock {
+            text = (text as NSString).replacingCharacters(in: range, with: replacement)
+            edits.append(id)
+            checks.append(text == expected)
+            return String(text)
+        }
+    }
+}
