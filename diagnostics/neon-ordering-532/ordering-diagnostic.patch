@@ -0,0 +1,225 @@
+import Foundation
+import RangeState
+import Testing
+import SwiftTreeSitter
+import NeonTestsTreeSitterSwift
+@testable import TreeSitterClient
+
+/// Scheduling is deliberately injected here; these are not CI reproductions.
+@MainActor
+@Suite(.serialized)
+struct OrderingDiagnosticsTests {
+    @Test(arguments: [true, false])
+    func reversedSubmissionAndDeliveryAreDistinguished(reverseSubmission: Bool) async throws {
+        let trace = OrderingTrace()
+        let context = OrderingContext(trace: trace)
+        let ledger = SnapshotLedger()
+        let processor = BackgroundProcessor(value: ledger, orderingContext: context)
+        let submit = HeldCalls()
+        let deliver = HeldCalls()
+        let gates = OrderingGates()
+        gates.submission = { id, action in MainActor.assumeIsolated { submit.hold(id, action) } }
+        gates.delivery = { id, action in MainActor.assumeIsolated { deliver.hold(id, action) } }
+        processor.orderingGates = gates
+        defer { processor.orderingGates = nil; submit.releaseAll(); deliver.releaseAll() }
+        var callbacks: [Int] = []
+        var values: [Int: String] = [:]
+        // This query has executed, but remains pending until its callback is delivered.
+        processor.accessValueForOrderingDiagnostics(isolation: MainActor.shared, preferSynchronous: false,
+            operation: { $0.snapshot }, completion: { (result: Result<String, Error>) in
+                values[0] = try? result.get(); callbacks.append(0)
+            })
+        try #require(await until { submit.ids.count == 1 })
+        let query = submit.ids[0]
+        submit.release(query)
+        try #require(await until { deliver.ids.contains(query) })
+        #expect(processor.hasPendingWork)
+
+        // Two distinct edits, each carrying an immutable expected content snapshot.
+        processor.accessValueForOrderingDiagnostics(isolation: MainActor.shared, preferSynchronous: true,
+            operation: { $0.apply(1, range: NSRange(location: 0, length: 0), replacement: "X", expected: "Xabcd") },
+            completion: { (result: Result<String, Error>) in values[1] = try? result.get(); callbacks.append(1) })
+        processor.accessValueForOrderingDiagnostics(isolation: MainActor.shared, preferSynchronous: true,
+            operation: { $0.apply(2, range: NSRange(location: 1, length: 1), replacement: "Y", expected: "XYbcd") },
+            completion: { (result: Result<String, Error>) in values[2] = try? result.get(); callbacks.append(2) })
+        try #require(await until { submit.ids.count == 2 })
+        let requests = trace.snapshot().events.filter { $0.phase == .request }.map(\.operation)
+        try #require(requests.count == 3)
+        let a = requests[1], b = requests[2]
+        let workerOrder = reverseSubmission ? [b, a] : [a, b]
+        // Wait for each held delivery so even worker submission order is controlled.
+        for id in workerOrder {
+            submit.release(id)
+            try #require(await until { deliver.ids.contains(id) })
+        }
+        #expect(callbacks.isEmpty)
+        #expect(ledger.applied == (reverseSubmission ? [2, 1] : [1, 2]))
+        #expect(ledger.snapshot == (reverseSubmission ? "XaYcd" : "XYbcd"))
+        #expect(ledger.snapshotChecks == (reverseSubmission ? [false, false] : [true, true]))
+
+        deliver.release(query)
+        for id in reverseSubmission ? workerOrder : [b, a] { deliver.release(id) }
+        #expect(callbacks == [0, 2, 1])
