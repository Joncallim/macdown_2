+@MainActor
+private final class ClientHeldCalls {
+    private var calls: [(UInt64, () -> Void)] = []
+    private var released: Set<UInt64> = []
+    private var draining = false
+    private var drainOrder: [UInt64]?
+    private var whenDrained: (() -> Void)?
+    var ids: [UInt64] { calls.map(\.0) }
+    func hold(_ id: UInt64, _ action: @escaping () -> Void) {
+        calls.append((id, action))
+        drainIfReady()
+    }
+    func release(_ id: UInt64) {
+        guard let index = calls.firstIndex(where: { $0.0 == id }) else {
+            Issue.record("missing held call"); return
+        }
+        let action = calls.remove(at: index).1
+        #expect(released.insert(id).inserted, "delivery action released exactly once")
+        action()
+    }
+    func releaseAll() { while let id = calls.first?.0 { release(id) } }
+    func beginOrderedDrain(_ order: [UInt64], whenDrained: @escaping () -> Void) {
+        drainOrder = order.filter { !released.contains($0) }
+        self.whenDrained = whenDrained
+        drainIfReady()
+    }
+    private func drainIfReady() {
+        guard !draining else { return }
+        draining = true
+        defer { draining = false }
+        while let first = drainOrder?.first, ids.contains(first) {
+            drainOrder?.removeFirst()
+            release(first)
+        }
+        if drainOrder?.isEmpty == true {
+            drainOrder = nil
+            let finished = whenDrained
+            whenDrained = nil
+            finished?()
+        }
+    }
+}
