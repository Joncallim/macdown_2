+        #expect(requested.filter { asynchronousSet.contains($0) } == asynchronous)
+        #expect(worker.filter { $0.phase == .resume }.map(\.operation) == asynchronous)
+        #expect(worker.filter { $0.phase == .callback }.allSatisfy { $0.retainedDeliveryCount == 1 })
+    }
+
+    func expectImmutableSnapshots() {
+        guard authoredSnapshots.count == 2, authoredReceiptIDs.count == 2 else {
+            Issue.record("expected two authored worker snapshots"); return
+        }
+        #expect(authoredSnapshots[0] != authoredSnapshots[1])
+        for (text, receipt) in zip(authoredSnapshots, authoredReceiptIDs) {
+            let reads = trace.snapshot().events.filter { $0.phase == .snapshotRead && $0.operation == receipt }
+            #expect(!reads.isEmpty, "actual parser read handler consumed each distinct snapshot")
+            #expect(reads.contains { $0.range.length > 0 })
+            let bytes = Data(text.utf16.flatMap { [UInt8($0 & 255), UInt8($0 >> 8)] })
+            for read in reads {
+                let start = read.range.location
+                let end = start + read.range.length
+                guard start >= 0, end <= bytes.count else { Issue.record("snapshot read out of bounds"); continue }
+                #expect(read.expected == receiptHash(bytes.subdata(in: start..<end)))
+            }
+        }
+    }
+
+    func releaseOutstanding(submissions: ClientHeldCalls, deliveries: ClientHeldCalls) {
+        client.installOrderingGatesForDiagnostics(nil)
+        // Keep the completion gate installed even when a callback has not yet
+        // arrived. A later callback drains only when its FIFO predecessor exists.
+        deliveries.beginOrderedDrain(Array(enqueuedMutationIDs().dropFirst())) { [weak client] in
+            client?.mutationCompletionGateForDiagnostics = nil
+        }
+        submissions.releaseAll()
+    }
+
+    func until(_ condition: () -> Bool) async -> Bool {
+        let deadline = ContinuousClock.now + .seconds(3)
+        while !condition(), ContinuousClock.now < deadline { await Task.yield() }
+        return condition()
+    }
+}
+
+@MainActor
+private final class ClientContent {
+    var text = "func start() {}\n"
+    var snapshots: [String] = []
+    var receipts: [UInt64] = []
+    func point(_ offset: Int) -> Point? {
+        guard offset >= 0, offset <= text.utf16.count else { return nil }
+        let prefix = Array(text.utf16.prefix(offset))
+        let row = prefix.filter { $0 == 10 }.count
+        let column = prefix.count - ((prefix.lastIndex(of: 10).map { $0 + 1 }) ?? 0)
+        return Point(row: row, column: column * 2)
+    }
+}
+
+/// Metadata-only signature of actual parser input bytes; no source enters the trace.
+private func receiptHash(_ data: Data) -> UInt64 {
+    data.reduce(UInt64(14695981039346656037)) { ($0 ^ UInt64($1)) &* 1099511628211 }
+}
