+        #expect(queried == fixture.originalHighlights, "query snapshot precedes both edits")
+        for (index, id) in mutationIDs.enumerated() {
+            submissions.release(id)
+            try #require(await fixture.until { deliveries.ids.count == index + 1 })
+        }
+        for id in fixture.enqueuedMutationIDs().dropFirst() { deliveries.release(id) }
+        try #require(await fixture.until { fixture.client.pendingMutationCountForDiagnostics == 0 })
+        #expect(try fixture.highlights() == fixture.freshHighlights())
