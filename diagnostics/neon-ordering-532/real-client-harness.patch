+import Foundation
+import RangeState
+import SwiftTreeSitter
+import SwiftTreeSitterLayer
+import NeonTestsTreeSitterSwift
+import Testing
+@testable import TreeSitterClient
+
+/// Real parser/client coverage; injected schedules are not a natural CI reproduction.
+@MainActor
+@Suite(.serialized)
+struct RealClientOrderingTests {
+    /// Gates remain nil: this observes the actual task/worker/callback schedule.
+    /// Observing a pending query does not hold, reorder or release any operation.
+    @Test(arguments: [4096, 32768])
+    func ungatedExecutedQueryAndTwoEditsPreserveOrdering(utf16Units: Int) async throws {
+        let text = String(repeating: "func start() {}\n", count: utf16Units / 16)
+        let fixture = try ClientFixture(initialText: text)
+        try await fixture.warm()
+        defer { fixture.dumpTrace(label: "executed-pending-\(utf16Units)") }
+        var queryResult: Result<[NamedRange], Error>?
+        var queryPhase = "not-started"
+        let query = Task {
+            queryPhase = "running"
+            do { queryResult = .success(try await fixture.client.queryForOrderingDiagnostics()); queryPhase = "success" }
+            catch { queryResult = .failure(error); queryPhase = "failure" }
+        }
+        defer { query.cancel() }
+        let observed = await fixture.until { fixture.hasExecutedPendingIssuedQuery() }
+        if !observed {
+            print("REAL_CLIENT_COVERAGE case=executed-pending-\(utf16Units) outcome=inconclusive reason=execute-without-callback-not-observed")
+            fixture.reportFailure(held: [], queryPhase: queryPhase)
+        }
+        try #require(observed, "coverage requires worker execution with its callback still outstanding; never substitute a gate")
+        fixture.edit(range: NSRange(location: 5, length: 5), replacement: "alpha")
+        fixture.edit(range: NSRange(location: 0, length: 0), replacement: "// prefix\n")
+        #expect(fixture.client.pendingMutationCountForDiagnostics == 2)
+        let completed = await fixture.until {
+            queryResult != nil && fixture.client.pendingMutationCountForDiagnostics == 0
+                && !fixture.client.backgroundHasPendingWorkForDiagnostics
+        }
+        if !completed { fixture.reportFailure(held: [], queryPhase: queryPhase) }
+        try #require(completed)
+        #expect(try #require(queryResult).get() == fixture.originalHighlights)
+        #expect(try await fixture.freshHighlightsAsync() == fixture.highlights())
+        fixture.expectOrderedExactlyOnce()
+        fixture.expectImmutableSnapshots()
+        fixture.expectEveryWorkerBoundaryOrdered()
+        try fixture.expectExecutedQueryCoverage()
+    }
+
+    @Test func cleanupWaitsForTheMissingEarlierCallback() {
+        let deliveries = ClientHeldCalls()
+        var completed: [Int] = []
+        var removedGate = false
+        deliveries.hold(2) { completed.append(2) }
+        deliveries.beginOrderedDrain([1, 2]) { removedGate = true }
+        #expect(completed.isEmpty)
+        #expect(!removedGate, "a missing predecessor must not disable the gate")
+        deliveries.hold(1) { completed.append(1) }
