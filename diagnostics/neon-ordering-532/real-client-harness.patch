+
+    @Test(arguments: [false, true])
+    func workerSubmissionAndMutationDeliveryAreSeparateBoundaries(invertSubmission: Bool) async throws {
+        let fixture = try ClientFixture()
+        try await fixture.warm()
+        let gates = OrderingGates()
+        let submissions = ClientHeldCalls()
+        let deliveries = ClientHeldCalls()
+        gates.submission = { id, action in MainActor.assumeIsolated { submissions.hold(id, action) } }
+        fixture.client.installOrderingGatesForDiagnostics(gates)
+        fixture.client.mutationCompletionGateForDiagnostics = { id, action in deliveries.hold(id, action) }
+        defer { fixture.releaseOutstanding(submissions: submissions, deliveries: deliveries) }
+        var queryResult: Result<[NamedRange], Error>?
+        var queryPhase = "not-started"
+        let query = Task {
+            queryPhase = "running"
+            do { queryResult = .success(try await fixture.client.queryForOrderingDiagnostics()); queryPhase = "success" }
+            catch { queryResult = .failure(error); queryPhase = "failure" }
+        }
+        defer { query.cancel() }
+        let hasOneQuery = await fixture.until { submissions.ids.count == 1 }
+        if !hasOneQuery { fixture.reportFailure(held: submissions.ids, queryPhase: queryPhase) }
+        try #require(hasOneQuery)
+        let queryID = submissions.ids[0]
+        fixture.edit(range: NSRange(location: 5, length: 5), replacement: "alpha")
+        fixture.edit(range: NSRange(location: 0, length: 4), replacement: "enum")
+        try #require(await fixture.until { submissions.ids.count == 3 })
+        #expect(fixture.client.pendingMutationCountForDiagnostics == 2)
+        let mutations = fixture.enqueuedMutationIDs().dropFirst()
+        let workers = fixture.workerMutationIDs()
+        try #require(mutations.count == 2 && workers.count == 2)
+        submissions.release(queryID)
+        try #require(await fixture.until { queryResult != nil })
+        #expect(try #require(queryResult).get() == fixture.originalHighlights)
+        let order = invertSubmission ? Array(workers.reversed()) : workers
+        for (index, id) in order.enumerated() {
+            submissions.release(id)
+            try #require(await fixture.until { deliveries.ids.count == index + 1 })
+        }
+        #expect(fixture.client.pendingMutationCountForDiagnostics == 2,
+                "worker execution is not mutation callback consumption")
+        #expect(!fixture.client.backgroundHasPendingWorkForDiagnostics)
+        let issued = Array(mutations)
+        let observed = deliveries.ids
+        #expect(observed == (invertSubmission ? Array(issued.reversed()) : issued))
+        let workerParents = fixture.executedMutationIDs().dropFirst()
+        #expect(Array(workerParents) == observed)
+        #expect((observed != issued) == invertSubmission,
+                "an injected inversion is detected without calling the fatal consumer out of order")
+
+        // Probe a reversed delivery choice separately from worker order. It is
+        // not forwarded to RangeProcessor; its exact original trap is retained.
+        if !invertSubmission {
+            #expect(Array(observed.reversed()) != issued)
+        }
+        for id in issued { deliveries.release(id) }
+        #expect(fixture.client.pendingMutationCountForDiagnostics == 0)
+        fixture.expectOrderedExactlyOnce(checkWorkerOrder: !invertSubmission)
+        if !invertSubmission {
+            #expect(try fixture.highlights() == fixture.freshHighlights())
+        }
+        fixture.expectImmutableSnapshots()
+    }
+}
